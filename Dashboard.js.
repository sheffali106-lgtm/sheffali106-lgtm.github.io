import { db } from "./firebase.js";

import {
    collection,
    getDocs,
    deleteDoc,
    doc
} from "https://www.gstatic.com/firebasejs/12.16.0/firebase-firestore.js";

const container = document.getElementById("dashboardProperties");

async function loadDashboard() {

    container.innerHTML = "<h3>Loading properties...</h3>";

    try {

        const snapshot = await getDocs(
            collection(db, "properties")
        );

        if (snapshot.empty) {

            container.innerHTML = `
                <h3>No properties found.</h3>
            `;

            return;
        }

        container.innerHTML = "";
        snapshot.forEach((documentSnapshot) => {

            const property = {
                id: documentSnapshot.id,
                ...documentSnapshot.data()
            };

            const card = document.createElement("div");

            card.className = "card";

            card.innerHTML = `
                <img src="${property.image || "https://picsum.photos/400/250"}" alt="${property.title}">

                <div class="card-content">

                    <h3>${property.title}</h3>

                    <p>📍 ${property.location}</p>

                    <p class="price">KSh ${property.price}/month</p>

                    <p>${property.description}</p>

                    <button class="edit-btn">✏️ Edit</button>

                    <button class="delete-btn">🗑️ Delete</button>

                </div>
            `;

            container.appendChild(card);

        });            card.querySelector(".edit-btn").addEventListener("click", () => {
                alert("Edit feature coming soon.");
            });

            card.querySelector(".delete-btn").addEventListener("click", async () => {

                const confirmed = confirm(
                    "Are you sure you want to delete this property?"
                );

                if (!confirmed) return;

                try {

                    await deleteDoc(doc(db, "properties", property.id));

                    alert("Property deleted successfully.");

                    loadDashboard();

                } catch (error) {

                    console.error(error);

                    alert("Failed to delete property.");

                }

            });

        });

    } catch (error) {

        console.error(error);

        container.innerHTML = `
            <h3>Failed to load properties.</h3>
            <p>${error.message}</p>
        `;

    }

}

loadDashboard();

